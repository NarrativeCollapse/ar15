;
; setup-2-trigger-guard.ngc - AR-15 lower receiver from a forging, setup 2:
; the bottoms of the trigger guard bosses, and a temporary clamping flat.
;
; Copyright (C) 2026 narrativecollapse.  Free software under the WTFPL,
; version 2, with no warranty: see LICENSE.
;
; Faces the bottoms of the rear and front trigger guard bosses, then mills
; a flat into the bottom of the magazine well.  The flat is on material
; that is removed later; it only gives later setups something to clamp on.
;
; Work holding: the forging is in the vise between the driver's side and
; passenger's side fixture plates, with the deck down on the bed of the
; vise.  (The plates need small changes from the book's drawings for
; this.)  The butt face sticks out of the left (-X) side of the vise
; against a work stop, such as a 1-2-3 block clamped to the table, so
; castings can be swapped without measuring anything.
;
; Datums:
;     X0     the butt face
;     Y0     the centre line of the forging
;     Z0     the finished level of the trigger guard bosses; the deck is
;            at Z-2.593
;


; -- settings ---------------------------------------------------------

#<clear_z> = 0.100

#<tool> = 5             ; 0.500 2-flute end mill
#<tool_dia> = 0.500
#<rpm> = 2000
#<boss_feed> = 10
#<flat_feed> = 5

#<rear_boss_x0> = 2.100
#<rear_boss_x1> = 2.775
#<rear_boss_width> = 0.660      ; across the forging (Y)

#<front_boss_x0> = 4.140
#<front_boss_x1> = 5.050
#<front_boss_width> = 1.325

; The bosses are cut 0.010 at a time from Z+0.010 down to #<boss_z>.
; Receivers 1-3 of the original project went to -0.020 and receiver 4
; to -0.025.
#<boss_top_z> = 0.020
#<boss_z> = -0.020
#<boss_step> = 0.010

; the clamping flat: 1.250 long (X) by 0.500 wide (Y), 0.260 deep
#<flat_x0> = 6.625
#<flat_x1> = 5.375
#<flat_top_z> = 0.050
#<flat_z> = -0.260
#<flat_step> = 0.130

#<do_bosses> = 1
#<do_flat> = 1


; -- program ----------------------------------------------------------

o<ar15-start> call [#<clear_z>]
o<ar15-tool> call [#<tool>] [#<rpm>] [#<boss_feed>] [#<tool_dia>]

; The cutter's path covers each boss with a cutter radius to spare at the
; ends and a full diameter to spare at the sides, so it plunges beside the
; boss, not on it.
#<end_margin> = [#<tool_dia> / 2]
#<side_margin> = #<tool_dia>
#<stepover> = [#<tool_dia> / 2]

o100 if [#<do_bosses>]

    #<x0> = [#<rear_boss_x0> - #<end_margin>]
    #<x1> = [#<rear_boss_x1> + #<end_margin>]
    #<y1> = [#<rear_boss_width> / 2 + #<side_margin>]
    o<ar15-pocket> call [#<x0>] [-#<y1>] [#<x1>] [#<y1>] [#<boss_top_z>] [#<boss_z>] [#<tool_dia>] [#<stepover>] [#<boss_step>] [0]

    #<x0> = [#<front_boss_x0> - #<end_margin>]
    #<x1> = [#<front_boss_x1> + #<end_margin>]
    #<y1> = [#<front_boss_width> / 2 + #<side_margin>]
    o<ar15-pocket> call [#<x0>] [-#<y1>] [#<x1>] [#<y1>] [#<boss_top_z>] [#<boss_z>] [#<tool_dia>] [#<stepover>] [#<boss_step>] [0]

o100 endif

o200 if [#<do_flat>]

    f#<flat_feed>
    o<ar15-pocket> call [#<flat_x0>] [-#<tool_dia> / 2] [#<flat_x1>] [#<tool_dia> / 2] [#<flat_top_z>] [#<flat_z>] [#<tool_dia>] [#<stepover>] [#<flat_step>] [0]

o200 endif

o<ar15-end> call
m2
